{
  "name": "space-mission-engine",
  "version": "0.1.0",
  "description": "Pure, unit-tested space mission design engine: orbits, Kepler, Hohmann transfers, life support/ECLSS, radiation, surface ops, scoring, trajectories, live-feed snapshots. No database, no backend.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lib/*": "./src/lib/*",
    "./data/*": "./src/data/*"
  },
  "files": [
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "tsx scripts/validate-data.ts"
  },
  "keywords": [
    "space",
    "mission-design",
    "orbital-mechanics",
    "kepler",
    "hohmann",
    "eclss",
    "life-support",
    "nasa",
    "nasa-space-apps"
  ],
  "author": "David (imredavid64-glitch)",
  "license": "MIT",
  "dependencies": {
    "minisearch": "^7.2.0",
    "satellite.js": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}